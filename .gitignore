# Default deny: ignore everything unless explicitly allowed below.
*

# Keep directory traversal possible.
!*/

# Project metadata and docs.
!.gitignore
!.dockerignore
!.env.example
!.python-version
!README.md
!README_CN.md
!RUNNING.md
!demonstration.md
!pyproject.toml
!uv.lock
!Dockerfile

# README screenshots.
!docs/
!docs/screenshots/
!docs/screenshots/*.png

# Backend source.
!backend/
!backend/**/*.py

# Frontend source and config.
!frontend/
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css

# Keep dependency folders hidden even though directory traversal is allowed above.
frontend/node_modules/
